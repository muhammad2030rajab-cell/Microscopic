# Copy to .env for local development, or set these in your hosting
# platform's environment variable settings for a real deploy. Never commit
# a real .env — see .gitignore.

# --- Database (required for a real deploy) ---------------------------------
# Real Postgres (Neon or otherwise). Without this, the app falls back to an
# embedded, in-memory PGLite database that is wiped on every restart — fine
# for local preview, NOT acceptable for anything with real users/data.
DATABASE_URL=

# --- Auth (required for a real deploy) --------------------------------------
# Turns real sign-in enforcement on. Leaving this unset/"false" with
# DATABASE_URL set makes every request fail closed (see
# src/lib/auth/verify.server.ts) rather than silently share one dev user.
VITE_AUTH_ENABLED=true

# Long random secret used to sign session tokens/cookies. Generate with:
#   openssl rand -hex 32
BETTER_AUTH_SECRET=

# The app's own public origin, e.g. https://labs.example.com — required so
# Better Auth issues cookies/redirects for the right host once deployed.
BETTER_AUTH_URL=


# --- Google Drive storage (optional, server-side only) ----------------------
# Use a Google OAuth refresh token for the Microscopic owner account.
# Never expose these as VITE_* variables and never commit real values.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Optional: an existing Google Drive folder ID. If blank, Microscopic creates
# a top-level "Microscopic Data" folder in the connected Drive.
GOOGLE_DRIVE_ROOT_FOLDER_ID=
